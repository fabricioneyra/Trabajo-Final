# Copiá este archivo como .env y completá tus claves. Nunca subas .env a GitHub.

# --- LLM (OpenAI) ---
OPENAI_API_KEY=sk-...
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- Observabilidad (LangSmith) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=fintechlab

# --- Memoria de conversaciones (Checkpointer) ---
# Con Docker Compose se completa sola (redis://redis:6379).
# Sin Docker: dejala vacía y se usa SQLite local (data/checkpoints.db).
REDIS_URL=

# --- Datos ---
DB_PATH=data/fintechlab.db

# --- RAG del agente de Atención ---
RAG_TOP_K=3
RAG_MIN_SIMILITUD=0.40

# --- BCRA ---
# mock = respuestas simuladas y estables (recomendado: los CUITs son sintéticos)
# real = consulta la API pública del BCRA
BCRA_MODO=mock
BCRA_BASE_URL=https://api.bcra.gob.ar
BCRA_TIMEOUT=10
BCRA_REINTENTOS=3

# --- Política de créditos ---
TASA_REFERENCIA_ANUAL=0.35
